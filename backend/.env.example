# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL via Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/slidevance_db?schema=public

# Authentication (JWT)
JWT_SECRET=slidevance_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Initial Administrator Seed Credentials
ADMIN_EMAIL=admin@slidevance.com
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME="Slidevance Administrator"

# File Storage Configuration
# Driver options: "local" or "s3"
STORAGE_DRIVER=local

# Local Storage settings (if STORAGE_DRIVER=local)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# S3-Compatible Storage settings (if STORAGE_DRIVER=s3)
# Works with AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces, Wasabi
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=slidevance-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Email Notification Service
# Provider options: "console" (prints to terminal for local dev), "smtp", "resend"
EMAIL_PROVIDER=console

# SMTP Settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
EMAIL_FROM="Slidevance Inquiries" <no-reply@slidevance.com>

# Resend Settings (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_123456789

# Notification Recipient
ADMIN_NOTIFICATION_EMAIL=admin@slidevance.com
