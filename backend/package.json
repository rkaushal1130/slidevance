{
  "name": "slidevance-backend",
  "version": "1.0.0",
  "description": "Slidevance Backend API - Express, TypeScript, Prisma PostgreSQL, JWT, Multer/S3, Nodemailer",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "test": "tsx tests/health.test.ts && tsx tests/auth.test.ts && tsx tests/inquiry.test.ts && tsx tests/portfolio.test.ts && tsx tests/services-industries.test.ts && tsx tests/storage.test.ts",
    "test:auth": "tsx tests/auth.test.ts",
    "test:inquiry": "tsx tests/inquiry.test.ts",
    "test:portfolio": "tsx tests/portfolio.test.ts",
    "test:services-industries": "tsx tests/services-industries.test.ts",
    "test:storage": "tsx tests/storage.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "slidevance",
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "jwt",
    "s3"
  ],
  "author": "Slidevance Team",
  "license": "ISC",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@prisma/client": "^6.4.1",
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^6.4.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
